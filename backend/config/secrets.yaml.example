# Databento API Configuration
# Copy this file to secrets.yaml and fill in your credentials
# DO NOT commit secrets.yaml to version control

databento:
  # API key from https://databento.com/portal/keys
  api_key: "your-api-key-here"

  # Live streaming endpoint
  live_endpoint: "wss://live.databento.com"

  # Historical data endpoint
  historical_endpoint: "https://hist.databento.com"

# Database paths
database:
  # Main database for live/historical data
  main_db: "data/market_data.duckdb"

  # Archive directory for Parquet files
  archive_dir: "data/archive"
